# ─────────────────────────────────────────────────────────────────────────────
# Agentic Month-End Assistant – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock model for the LLM backbone
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS AgentCore – Memory namespace (created via AgentCore console or CLI)
AGENTCORE_MEMORY_ID=your-agentcore-memory-id
AGENTCORE_AGENT_ID=your-agentcore-agent-id
AGENTCORE_AGENT_ALIAS_ID=your-agentcore-agent-alias-id

# ── MS Teams ─────────────────────────────────────────────────────────────────
# Incoming Webhook URL for the #month-end-approvals channel
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your-token

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token (xoxb-...) and target channel for approval notifications
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APPROVAL_CHANNEL=#month-end-approvals

# ── App settings ─────────────────────────────────────────────────────────────
# HITL variance threshold – request approval when variance > this % of budget
HITL_VARIANCE_THRESHOLD_PCT=5.0
# Max research iterations before the reflection loop exits
MAX_RESEARCH_ITERATIONS=3
# Whether to run financial code in the sandbox (recommended: true)
SANDBOX_ENABLED=true
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

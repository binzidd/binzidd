# ─────────────────────────────────────────────────────────────────────────────
# Month-End Assistant – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Core ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── AWS AgentCore (leave blank to fall back to local LangGraph) ───────────────
AGENTCORE_AGENT_ID=
AGENTCORE_AGENT_ALIAS_ID=TSTALIASID
AGENTCORE_MEMORY_ID=

# ── HITL Notifications ────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=#month-end-approvals

# ── Behaviour Tunables ────────────────────────────────────────────────────────
HITL_VARIANCE_THRESHOLD_PCT=5
MAX_RESEARCH_ITERATIONS=3
SANDBOX_ENABLED=true

# ── Streamlit Frontend ────────────────────────────────────────────────────────
# Points the Streamlit container to the FastAPI backend.
# In local dev both run on localhost; in ECS Fargate this is set automatically.
BACKEND_URL=http://localhost:8000

# ── Streamlit Auth ────────────────────────────────────────────────────────────
# Generate a bcrypt hash with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
APP_USERNAME=mea_admin
APP_PASSWORD_HASH=

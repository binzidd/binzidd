FROM python:3.12-slim

WORKDIR /app

# System deps for RestrictedPython and httpx
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "uvicorn[standard]>=0.30" "fastapi>=0.112"

# Copy source
COPY month_end_assistant/ ./month_end_assistant/
COPY frontend/ ./frontend/
COPY .env.example .env

EXPOSE 8000

CMD ["uvicorn", "frontend.api.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
